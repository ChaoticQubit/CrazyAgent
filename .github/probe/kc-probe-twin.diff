+/// Probe: copies the fresh scratch keychain to `PROBE_KEYCHAIN_SAVE`, or deletes it and puts
+/// the file at `PROBE_KEYCHAIN_FROM` in its place as the home's default and only search-list
+/// keychain, unlocked with the empty password. Input: the keychain path, three levels under
+/// its home. Output: none; panics on a failed step.
+fn probe_swap(path: &std::path::Path) {
+    let home = path.ancestors().nth(3).unwrap();
+    let text = path.to_str().unwrap();
+    eprintln!("PROBE-KEYCHAIN {text}");
+    let security = |args: &[&str]| {
+        let ran = Command::new(SECURITY)
+            .args(args)
+            .env_clear()
+            .env("HOME", home)
+            .env("PATH", "/usr/bin:/bin")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .unwrap();
+        assert!(ran.success(), "probe security {:?} failed", args.first());
+    };
+    if let Some(to) = std::env::var_os("PROBE_KEYCHAIN_SAVE") {
+        std::fs::copy(path, to).unwrap();
+    }
+    if let Some(from) = std::env::var_os("PROBE_KEYCHAIN_FROM") {
+        security(&["delete-keychain", text]);
+        std::fs::copy(from, path).unwrap();
+        security(&["list-keychains", "-d", "user", "-s", text]);
+        security(&["default-keychain", "-d", "user", "-s", text]);
+        security(&["unlock-keychain", "-p", "", text]);
+    }
+}
