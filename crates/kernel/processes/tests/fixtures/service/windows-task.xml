<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
<RegistrationInfo><Description>CrazyAgent engine</Description></RegistrationInfo>
<Triggers><LogonTrigger><Enabled>true</Enabled><UserId>HOST\owner</UserId></LogonTrigger></Triggers>
<Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
<Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><ExecutionTimeLimit>PT0S</ExecutionTimeLimit><RestartOnFailure><Interval>PT1M</Interval><Count>3</Count></RestartOnFailure><Hidden>true</Hidden></Settings>
<Actions Context="Author"><Exec><Command>%SystemRoot%\System32\cmd.exe</Command><Arguments>/d /s /c &quot;set &quot;PATH=/Users/owner/.local/bin:/opt/homebrew/bin:/usr/bin:/bin&quot; &amp;&amp; &quot;/Applications/CrazyAgent.app/Contents/MacOS/crazyagent&quot; engine --home &quot;/Users/owner/Library/Application Support/CrazyAgent/engine&quot; &gt;&gt; &quot;/Users/owner/Library/Application Support/CrazyAgent/engine/logs/engine.log&quot; 2&gt;&amp;1&quot;</Arguments></Exec></Actions>
</Task>
