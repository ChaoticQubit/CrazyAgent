<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.crazyagent.engine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/CrazyAgent.app/Contents/MacOS/crazyagent</string>
		<string>engine</string>
		<string>--home</string>
		<string>/Users/owner/Library/Application Support/CrazyAgent/engine</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/owner/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/owner</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/Users/owner/Library/Application Support/CrazyAgent/engine/logs/engine.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/owner/Library/Application Support/CrazyAgent/engine/logs/engine.log</string>
</dict>
</plist>
