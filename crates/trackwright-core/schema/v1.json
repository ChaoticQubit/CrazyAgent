            ],
            "type": "string"
          },
          "priority": {
            "description": "The new priority.",
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
