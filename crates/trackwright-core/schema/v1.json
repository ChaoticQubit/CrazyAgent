          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "result": {
            "description": "pass or fail.",
            "enum": [
              "pass",
              "fail"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "position",
          "kind",
          "ref",
          "result"
        ],
        "type": "object"
      },
