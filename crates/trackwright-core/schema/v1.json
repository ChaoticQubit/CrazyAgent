            "type": "string"
          },
          "version": {
            "description": "The version you last read; a newer stored version refuses the write as stale.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "on"
        ],
        "type": "object"
      },
      "summary": "Records that a ticket waits for another one to close.",
      "write": true
    },
    "edit": {
      "args": {
        "additionalProperties": false,
