    "evidence_record": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "description": "Where the outcome can be read, for example a run URL.",
            "maxBytes": 512,
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "kind": {
            "description": "The check's kind.",
            "enum": [
              "test",
              "change",
              "manual",
              "ci"
