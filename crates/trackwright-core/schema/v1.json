{
  "$id": "trackwright:schema:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "api": 1,
  "codes": [
    "text_empty",
    "text_too_long",
    "text_line_break",
    "text_hidden_characters",
    "project_key_invalid",
    "project_exists",
    "project_unknown",
    "short_id_invalid",
    "ticket_unknown",
    "actor_invalid",
    "priority_invalid",
    "cycle_days_invalid",
    "stale_version",
    "status_closed_at_create",
    "close_reason_open",
    "tickets_full",
    "criteria_full",
    "criterion_unknown",
    "links_full",
    "link_exists",
    "link_unknown",
    "store_path_refused",
    "store_not_private",
    "store_schema_newer",
    "store_failed",
    "unknown_op",
    "args_invalid",
    "unknown_field",
    "missing_field",
    "field_invalid",
    "request_too_large",
    "request_id_reused",
    "cursor_invalid",
    "op_unavailable",
    "use_close",
    "rate_limited",
    "open_tickets_full"
  ],
  "ops": {
    "check_add": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "kind": {
            "description": "What proves it.",
            "enum": [
              "test",
              "change",
              "manual",
              "ci"
            ],
            "type": "string"
          },
          "position": {
            "description": "The criterion's position on the ticket, from 1.",
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          },
          "ref": {
            "description": "The test, change, check or CI job it names.",
            "maxBytes": 512,
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "position",
          "kind",
          "ref"
        ],
        "type": "object"
      },
      "summary": "Adds a check that proves a criterion: a test, a change, a manual check or a CI run.",
      "write": true
    },
    "claim": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "version": {
            "description": "The version you last read; a newer stored version refuses the write as stale.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      },
      "summary": "Assigns an unclaimed ticket to you; one claimer wins.",
      "write": true
    },
    "close": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "reason": {
            "description": "Why it closes.",
            "maxBytes": 1024,
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "status": {
            "description": "done or cancelled; done when absent.",
            "enum": [
              "triage",
              "backlog",
              "todo",
              "in_progress",
              "in_review",
              "done",
              "cancelled"
            ],
            "type": "string"
          },
          "version": {
            "description": "The version you last read; a newer stored version refuses the write as stale.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "type": "object"
      },
      "summary": "Closes a ticket as done or cancelled, as the project's close policy allows.",
      "write": true
    },
    "create": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "description": "What and why, in Markdown.",
            "maxBytes": 16384,
            "maxLength": 16384,
            "type": "string"
          },
          "kind": {
            "description": "feature when absent.",
            "enum": [
              "feature",
              "bug",
              "chore",
              "spike"
            ],
            "type": "string"
          },
          "priority": {
            "description": "0 most urgent to 4 least; 2 when absent.",
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project's key, for example CA.",
            "pattern": "^[A-Z]{2,8}$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "status": {
            "description": "An open status to start in; the project's create policy decides when absent.",
            "enum": [
              "triage",
              "backlog",
              "todo",
              "in_progress",
              "in_review",
              "done",
              "cancelled"
            ],
            "type": "string"
          },
          "title": {
            "description": "One line naming the work.",
            "maxBytes": 200,
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          }
        },
        "required": [
          "project",
          "title"
        ],
        "type": "object"
      },
      "summary": "Creates a ticket in a project.",
      "write": true
    },
    "criterion_add": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "text": {
            "description": "One checkable line.",
            "maxBytes": 500,
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "summary": "Adds an open acceptance criterion at the ticket's next position.",
      "write": true
    },
    "criterion_edit": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "position": {
            "description": "The criterion's position on the ticket, from 1.",
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "text": {
            "description": "The new text.",
            "maxBytes": 500,
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "version": {
            "description": "The criterion version you last read.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "position",
          "version",
          "text"
        ],
        "type": "object"
      },
      "summary": "Rewrites a criterion's text.",
      "write": true
    },
    "criterion_set": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "position": {
            "description": "The criterion's position on the ticket, from 1.",
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "state": {
            "description": "open, met or waived.",
            "enum": [
              "open",
              "met",
              "waived"
            ],
            "type": "string"
          },
          "version": {
            "description": "The criterion version you last read.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "position",
          "version",
          "state"
        ],
        "type": "object"
      },
      "summary": "Sets a criterion open, met or waived.",
      "write": true
    },
    "cycle_close": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "number": {
            "description": "The cycle's number.",
            "maximum": 520,
            "minimum": 1,
            "type": "integer"
          },
          "project": {
            "description": "The project's key, for example CA.",
            "pattern": "^[A-Z]{2,8}$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "version": {
            "description": "The cycle version you last read.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "project",
          "number",
          "version"
        ],
        "type": "object"
      },
      "summary": "Closes a cycle; unfinished work rolls over as the project's rollover policy says.",
      "write": true
    },
    "cycle_start": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "description": "Its length; the project's cycle_days when absent.",
            "maximum": 90,
            "minimum": 1,
            "type": "integer"
          },
          "project": {
            "description": "The project's key, for example CA.",
            "pattern": "^[A-Z]{2,8}$",
            "type": "string"
          },
          "release": {
            "description": "The product version it works toward.",
            "maxBytes": 64,
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "request_id": {
            "description": "Your key for this write; repeating it with the same fields returns the first reply.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "starts_day": {
            "description": "Its first day, YYYY-MM-DD; today when absent.",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          }
        },
        "required": [
          "project"
        ],
        "type": "object"
      },
      "summary": "Starts a project's next cycle.",
      "write": true
    },
    "depend": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The ticket's short id, for example CA-42.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "on": {
            "description": "The ticket it waits for.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
