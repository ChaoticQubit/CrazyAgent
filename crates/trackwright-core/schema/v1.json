      "write": true
    },
    "export": {
      "args": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Only this ticket.",
            "pattern": "^[A-Z]{2,8}-[1-9][0-9]{0,9}$",
            "type": "string"
          },
          "path": {
            "description": "The file to write; the reply carries the text when absent.",
