{
  "argv": [
    "/usr/bin/sandbox-exec",
    "-f",
    "<path-1>/work/project.sb",
    "/bin/sh",
    "-c",
    "e=$1; r=$2; shift 2\nn=$CRAZYAGENT_INTERPRETER\ns=$CODEX_HOME/app-server-control/app-server-control.sock\n/bin/rm -f \"$s\"\n${n:+\"$n\"} \"$e\" app-server --listen unix:// \"$@\" </dev/null >/dev/null 2>&1 &\na=$!\ni=0\nwhile [ ! -S \"$s\" ] && kill -0 \"$a\" 2>/dev/null && [ \"$i\" -lt 50 ]; do /bin/sleep 0.1; i=$((i+1)); done\nif [ -S \"$s\" ]; then set -- --remote unix:// \"$@\"; else kill \"$a\" 2>/dev/null; fi\nif [ -n \"$r\" ]; then ${n:+\"$n\"} \"$e\" \"$@\" resume \"$r\"; else ${n:+\"$n\"} \"$e\" \"$@\"; fi\nc=$?\nkill \"$a\" 2>/dev/null\nexit \"$c\"\n",
    "codex-bridge",
    "/usr/bin/true",
    "",
    "-c",
    "cli_auth_credentials_store=\"file\"",
    "-c",
    "model_provider=\"openai\"",
    "-c",
    "model=\"snapshot-model\"",
    "-c",
    "sandbox_mode=\"danger-full-access\"",
    "-c",
    "approval_policy=\"never\"",
    "-c",
    "features.apps=false",
    "-c",
    "features.plugins=false",
    "-c",
    "features.goals=false",
    "-c",
    "features.multi_agent=false",
    "-c",
    "features.multi_agent_v2=false",
    "-c",
    "mcp_servers={}",
    "-c",
    "check_for_update_on_startup=false",
    "-c",
    "projects={\"<path-1>/work\"={trust_level=\"trusted\"}}",
    "-c",
    "tui.alternate_screen=\"always\""
  ],
  "cwd": "<path-1>/work",
  "env_names": [
    "HOME",
    "PATH",
    "LANG",
    "LC_ALL",
    "CODEX_HOME",
    "TMPDIR",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTUP_AUTO_INSTALL",
    "UV_PYTHON_DOWNLOADS",
    "COREPACK_ENABLE_NETWORK",
    "HOMEBREW_NO_AUTO_UPDATE",
    "TMPPREFIX",
    "GIT_CONFIG_NOSYSTEM",
    "GIT_TERMINAL_PROMPT",
    "GIT_CONFIG_COUNT",
    "GIT_CONFIG_KEY_0",
    "GIT_CONFIG_VALUE_0",
    "GIT_CONFIG_KEY_1",
    "GIT_CONFIG_VALUE_1",
    "SSL_CERT_FILE",
    "GIT_CONFIG_GLOBAL",
    "PYTHONNOUSERSITE",
    "NPM_CONFIG_USERCONFIG"
  ],
  "handover": {
    "key_absent": true,
    "names_the_relay": null
  },
  "home_files": [],
  "sdkroot": "as_the_engine_gives_it",
  "transcript": {
    "kind": "codex_rollouts",
    "sessions": "<path-1>/home/sessions"
  }
}
