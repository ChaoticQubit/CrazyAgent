{
  "argv": [
    "/usr/bin/sandbox-exec",
    "-f",
    "<path-1>/work/project.sb",
    "/usr/bin/true",
    "--no-daemon",
    "-c",
    "cli_auth_credentials_store=\"file\"",
    "-c",
    "model_providers.crazyagent={name=\"CrazyAgent\",base_url=\"http://127.0.0.1:<port>/v1\",wire_api=\"responses\",auth={command=\"/bin/cat\",args=[\"<path-1>/home/.crazyagent-key\"]}}",
    "-c",
    "model_provider=\"crazyagent\"",
    "-c",
    "model=\"snapshot-model\"",
    "-c",
    "sandbox_mode=\"read-only\"",
    "-c",
    "approval_policy=\"never\"",
    "-c",
    "features.shell_tool=false",
    "-c",
    "features.apply_patch_freeform=false",
    "-c",
    "features.unified_exec=false",
    "-c",
    "features.view_image=false",
    "-c",
    "features.multi_agent=false",
    "-c",
    "features.code_mode=false",
    "-c",
    "features.apps=false",
    "-c",
    "features.plugins=false",
    "-c",
    "features.goals=false",
    "-c",
    "web_search=\"disabled\"",
    "-c",
    "mcp_servers={}",
    "-c",
    "tools.experimental_request_user_input.enabled=false",
    "-c",
    "check_for_update_on_startup=false",
    "-c",
    "projects={\"<path-1>/work\"={trust_level=\"trusted\"}}",
    "-c",
    "tui.alternate_screen=\"always\""
  ],
  "cwd": "<path-1>/work",
  "env_names": [
    "HOME",
    "PATH",
    "LANG",
    "LC_ALL",
    "CODEX_HOME",
    "TMPDIR",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTUP_AUTO_INSTALL",
    "UV_PYTHON_DOWNLOADS",
    "COREPACK_ENABLE_NETWORK",
    "HOMEBREW_NO_AUTO_UPDATE",
    "TMPPREFIX",
    "GIT_CONFIG_NOSYSTEM",
    "GIT_TERMINAL_PROMPT",
    "GIT_CONFIG_COUNT",
    "GIT_CONFIG_KEY_0",
    "GIT_CONFIG_VALUE_0",
    "GIT_CONFIG_KEY_1",
    "GIT_CONFIG_VALUE_1",
    "SSL_CERT_FILE",
    "GIT_CONFIG_GLOBAL",
    "PYTHONNOUSERSITE",
    "NPM_CONFIG_USERCONFIG"
  ],
  "handover": {
    "key_absent": true,
    "names_the_relay": true
  },
  "home_files": [
    ".crazyagent-key"
  ],
  "sdkroot": "as_the_engine_gives_it",
  "transcript": {
    "kind": "codex_rollouts",
    "sessions": "<path-1>/home/sessions"
  }
}
