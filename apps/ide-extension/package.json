{
  "name": "crazyagent-ide",
  "displayName": "CrazyAgent",
  "description": "CrazyAgent change sets, agents and memories inside the CrazyAgent IDE.",
  "publisher": "crazyagent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crazyagent.editAnyway",
        "title": "Edit anyway",
        "category": "CrazyAgent",
        "icon": "$(unlock)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "crazyagent.editAnyway",
          "when": "activeEditorIsReadonly && resourcePath =~ /\\/worktrees\\/agent-[1-9][0-9]*\\//",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "crazyagent.editAnyway",
          "when": "activeEditorIsReadonly"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../desktop/node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0"
  }
}
