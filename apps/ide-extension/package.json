{
  "name": "crazyagent-ide",
  "displayName": "CrazyAgent",
  "description": "CrazyAgent change sets, agents and memories inside the CrazyAgent IDE.",
  "publisher": "crazyagent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "CrazyAgent Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/crazyagent-dark.json"
      },
      {
        "label": "CrazyAgent Light",
        "uiTheme": "vs",
        "path": "./themes/crazyagent-light.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crazyagent",
          "title": "CrazyAgent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "crazyagent": [
        {
          "id": "crazyagent.memories",
          "name": "Memories"
        },
        {
          "id": "crazyagent.agents",
          "name": "Agents"
        },
        {
          "id": "crazyagent.changeSets",
          "name": "Change sets"
        },
        {
          "id": "crazyagent.context",
          "name": "Brief and documents"
        }
      ]
    },
    "commands": [
      {
        "command": "crazyagent.memories.approve",
        "title": "Approve",
        "category": "CrazyAgent",
        "icon": "$(check)"
      },
      {
        "command": "crazyagent.memories.reject",
        "title": "Reject",
        "category": "CrazyAgent",
        "icon": "$(close)"
      },
      {
        "command": "crazyagent.agents.message",
        "title": "Message",
        "category": "CrazyAgent",
        "icon": "$(comment)"
      },
      {
        "command": "crazyagent.agents.openWorktree",
        "title": "Show worktree",
        "category": "CrazyAgent",
        "icon": "$(folder-opened)"
      },
      {
        "command": "crazyagent.memories.refresh",
        "title": "Refresh",
        "category": "CrazyAgent",
        "icon": "$(refresh)"
      },
      {
        "command": "crazyagent.agents.refresh",
        "title": "Refresh",
        "category": "CrazyAgent",
        "icon": "$(refresh)"
      },
      {
        "command": "crazyagent.changeSets.refresh",
        "title": "Refresh",
        "category": "CrazyAgent",
        "icon": "$(refresh)"
      },
      {
        "command": "crazyagent.context.refresh",
        "title": "Refresh",
        "category": "CrazyAgent",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "crazyagent.memories.approve",
          "when": "view == crazyagent.memories && viewItem == memory.pending",
          "group": "inline"
        },
        {
          "command": "crazyagent.memories.reject",
          "when": "view == crazyagent.memories && viewItem == memory.pending",
          "group": "inline"
        },
        {
          "command": "crazyagent.agents.message",
          "when": "view == crazyagent.agents && viewItem =~ /\\bagent\\.message\\b/",
          "group": "inline"
        },
        {
          "command": "crazyagent.agents.openWorktree",
          "when": "view == crazyagent.agents && viewItem =~ /\\bagent\\.worktree\\b/",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "crazyagent.memories.refresh",
          "when": "view == crazyagent.memories",
          "group": "navigation"
        },
        {
          "command": "crazyagent.agents.refresh",
          "when": "view == crazyagent.agents",
          "group": "navigation"
        },
        {
          "command": "crazyagent.changeSets.refresh",
          "when": "view == crazyagent.changeSets",
          "group": "navigation"
        },
        {
          "command": "crazyagent.context.refresh",
          "when": "view == crazyagent.context",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "crazyagent.memories.approve",
          "when": "false"
        },
        {
          "command": "crazyagent.memories.reject",
          "when": "false"
        },
        {
          "command": "crazyagent.agents.message",
          "when": "false"
        },
        {
          "command": "crazyagent.agents.openWorktree",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../desktop/node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0"
  }
}
