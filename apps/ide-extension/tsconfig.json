{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "out",
    "newLine": "lf",
    "removeComments": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "../desktop/node_modules/@types"],
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
