{
  "identifier": "terminal-wall",
  "description": "Terminal wall windows reach only the agent terminals and their native views, the team graph, Stop, the Terminals per window setting, opening their own project's next windows, bringing forward the main window or their own project's windows, and closing their own project's windows once that project is gone.",
  "local": true,
  "windows": ["terminals-*"],
  "webviews": ["terminals-*"],
  "permissions": [
    "allow-desktop-terminal-prompt",
    "allow-desktop-native-terminal-enabled",
    "allow-desktop-native-terminal-open",
    "allow-desktop-native-terminal-place",
    "allow-desktop-native-terminal-cover",
    "allow-desktop-native-terminal-focus",
    "allow-desktop-native-terminal-style",
    "allow-desktop-native-terminal-copy",
    "allow-desktop-native-terminal-paste",
    "allow-desktop-native-terminal-jump",
    "allow-desktop-native-terminal-keys",
    "allow-desktop-native-terminal-close",
    "allow-desktop-team-graph",
    "allow-desktop-team-stop-agent",
    "allow-desktop-team-stop-teammate",
    "allow-desktop-terminals-per-window",
    "allow-desktop-extend-terminal-windows",
    "allow-desktop-focus-terminal-window",
    "allow-desktop-close-project-walls"
  ]
}
