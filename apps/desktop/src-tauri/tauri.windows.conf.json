{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Run and watch a team of coding agents on your own projects.",
    "windows": {
      "signCommand": {
        "cmd": "node",
        "args": ["../../../scripts/release/sign-windows.mjs", "%1"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
