abi <abi/4.0>,

include <tunables/global>

profile crazyagent-landlock /usr/bin/crazyagent-landlock flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace (read, trace, readby),
  allow ptrace (tracedby) peer=crazyagent-{landlock,agent},
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow /usr/bin/bwrap ix,
  allow /usr/bin/crazyagent-landlock ix,
  allow /usr/bin/slirp4netns ix,
  allow /usr/sbin/xtables-nft-multi ix,
  allow px /** -> crazyagent-landlock//&crazyagent-agent,

  include if exists <local/crazyagent-landlock>
}

profile crazyagent-agent flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &crazyagent-agent,
  audit deny capability,

  include if exists <local/crazyagent-agent>
}
