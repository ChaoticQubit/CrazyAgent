{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Run and watch a team of coding agents on your own projects.",
    "linux": {
      "deb": {
        "depends": ["xdg-utils", "bubblewrap"],
        "recommends": ["slirp4netns", "iptables"],
        "section": "devel",
        "files": {
          "/usr/share/crazyagent/apparmor/crazyagent-landlock": "linux/apparmor/crazyagent-landlock"
        },
        "postInstallScript": "linux/deb/postinst",
        "preRemoveScript": "linux/deb/prerm"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
