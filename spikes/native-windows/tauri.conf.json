{
  "productName": "native-windows-spike",
  "version": "0.1.0",
  "identifier": "dev.crazyagent.nativewindowsspike",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "native windows spike",
        "width": 1000,
        "height": 700,
        "center": true,
        "focus": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
